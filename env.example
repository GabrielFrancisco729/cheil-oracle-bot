# ============================================================================
# ARQUIVO: .env.example
# 
# INSTRUÇÕES:
# 1. Copie este arquivo para .env
# 2. Preencha as variáveis com seus valores reais
# 3. NUNCA commite o arquivo .env no Git (coloque em .gitignore)
# ============================================================================

# ============================================================================
# GOOGLE CLOUD / BigQuery
# ============================================================================

# ID do seu projeto GCP
GCP_PROJECT_ID=cheil-bi

# Caminho para o arquivo JSON da service account
# Você baixou isso quando criou a service account no GCP
GCP_SERVICE_ACCOUNT_JSON=./service-account-key.json

# Datasets do BigQuery
BQ_DATASET_MAIN=consolidated
BQ_DATASET_DIMENSIONS=alldimensions

# ============================================================================
# OpenAI OAuth (para usuários se autenticarem)
# ============================================================================

# Seu Client ID do OpenAI
# Registre em: https://platform.openai.com/account/apps
OPENAI_CLIENT_ID=seu-client-id-aqui

# Seu Client Secret do OpenAI
OPENAI_CLIENT_SECRET=seu-client-secret-aqui

# URL de callback (onde OpenAI redireciona após login)
# Local: http://localhost:3000/auth/callback
# Produção: https://seu-dominio.com/auth/callback
OPENAI_REDIRECT_URI=http://localhost:3000/auth/callback

# ============================================================================
# JWT (para criar tokens de sessão)
# ============================================================================

# Chave secreta para assinar JWTs
# Gere algo forte: openssl rand -hex 32
JWT_SECRET=seu-secret-super-seguro-aqui-mude-em-producao

# ============================================================================
# Servidor
# ============================================================================

# Porta do servidor
PORT=3000

# URL do frontend (para CORS)
FRONTEND_URL=http://localhost:3000

# Ambiente (development / production)
NODE_ENV=development

# ============================================================================
# RENDER (se estiver deployando)
# ============================================================================

# O Render define PORT automaticamente
# Não precisa mexer aqui, mas deixa para referência
# PORT é lido do ambiente automaticamente
